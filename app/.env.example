# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # Application ID
APP_SECRET=               # Application secret (used for JWT signing)
APP_URL=                  # Public app URL (e.g. http://localhost:3000)

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)

# ── Frontend (exposed to browser via Vite) ──────────────────────
VITE_OAUTH_AUTH_URL=      # OAuth server URL (e.g. https://auth.example.com)
VITE_APP_ID=              # OAuth application ID

# ── Backend (Auth) ─────────────────────────────────────────────
OAUTH_AUTH_URL=           # OAuth server URL (backend token/JWKS endpoints)
OAUTH_API_URL=            # OAuth API URL (e.g. https://api.example.com)

# ── Stripe Payments ──────────────────────────────────────────────
STRIPE_SECRET_KEY=        # Stripe secret key (sk_...)
STRIPE_WEBHOOK_SECRET=    # Stripe webhook signing secret (whsec_...)
STRIPE_PRICE_CURRENCY=usd # Default checkout currency

# ── Digital File Delivery (S3 compatible) ────────────────────────
AWS_REGION=
AWS_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Admin Role ──────────────────────────────────────────────────
OWNER_UNION_ID=           # Union ID of the app creator; this user gets role "admin" on first login
